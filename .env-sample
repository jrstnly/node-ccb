# Used by `npm run test:live`. Copy to .env (gitignored) and fill in.
CCB_CHURCH=**CCB Subdomain**
CCB_CLIENT=**CCB Client ID**
CCB_SECRET=**CCB Client Secret**
# Only needed for the authorization_code flow. Must exactly match the registered redirect URI.
CCB_REDIRECT_URI=
# Authorization code for the church.
CCB_CODE=
# Set to true when using sandbox credentials.
CCB_SANDBOX=false
# Leave empty for the default (client_credentials: the code is re-sent for every token), or set to
# authorization_code for the documented single-use code + rotating refresh token flow.
CCB_GRANT_TYPE=
